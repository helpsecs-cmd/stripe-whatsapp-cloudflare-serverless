# ============================================================
# CONFIGURAÇÕES DO NOTIFICADOR STRIPE -> WHATSAPP
# Adicione estas variáveis no Cloudflare Pages (Environment Variables)
# ============================================================

# Número do WhatsApp do vendedor que receberá os alertas (DDI + DDD + Número)
SELLER_WHATSAPP=5511999998888

# --- OPÇÃO 1: CALLMEBOT (R$ 0 / Zero Servidor) ---
# Envie "I allow callmebot to send me messages" para +34 911 06 13 84 no WhatsApp para gerar sua chave grátis
CALLMEBOT_API_KEY=sua_api_key_callmebot

# --- OPÇÃO 2: EVOLUTION API (Self-hosted) ---
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua_chave_evolution
EVOLUTION_INSTANCE=vendas

# --- OPÇÃO 3: Z-API ---
ZAPI_INSTANCE_ID=seu_instance_id
ZAPI_TOKEN=seu_token_zapi

# --- OPÇÃO 4: WEBHOOK GENÉRICO (n8n / Make / Discord) ---
ZAP_WEBHOOK_URL=https://webhook.site/seu-id
